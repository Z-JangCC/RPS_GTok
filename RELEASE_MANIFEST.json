{
  "name": "RPS_GTok",
  "purpose": "Reproducible release for the final RPS-GTok tokenizer and downstream Transformer paper experiments.",
  "main_package": "gptok2_tokenizer",
  "auxiliary_packages": [
    "gptok2",
    "gptok2_compact",
    "gptok2_motif_macro",
    "gptok2_evaluation",
    "rps_gtok_consumption"
  ],
  "included_reference_artifacts": [
    "reports/representative/summary_all.csv",
    "reports/representative/test_comparison.csv",
    "reports/representative/dataset_status.csv",
    "reports/representative/cora_full_graph_summary.csv"
  ],
  "recommended_commands": [
    "python scripts/reproduce_smoke.py",
    "python -m rps_gtok_consumption.cli run-config --config configs/consumer_multiview_smoke.yaml --out runs/rps_gtok_multiview",
    "python scripts/reproduce_release.py",
    "python scripts/verify_release.py"
  ]
}
