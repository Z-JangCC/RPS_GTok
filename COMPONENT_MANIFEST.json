{
  "name": "RPS_GTok",
  "version": "0.5.0",
  "description": "Anonymous release containing the final RPS-GTok tokenizer, downstream Transformer consumer, and final paper evaluation artifacts.",
  "recommended_mode": "motif_hybrid",
  "modes": [
    "original",
    "compact",
    "entropy",
    "motif_macro",
    "motif_entropy",
    "motif_hybrid"
  ],
  "included_packages": [
    "gptok2",
    "gptok2_compact",
    "gptok2_motif_macro",
    "gptok2_tokenizer",
    "gptok2_evaluation",
    "rps_gtok_consumption"
  ],
  "included_reports": [
    "reports/representative/summary_all.csv",
    "reports/representative/test_comparison.csv",
    "reports/representative/dataset_status.csv",
    "reports/representative/cora_full_graph_summary.csv"
  ],
  "entrypoints": {
    "python_api": "from gptok2_tokenizer import GPTok2Tokenizer",
    "cli_module": "python -m gptok2_tokenizer.cli",
    "console_script": "gptok2-tokenizer",
    "evaluation_cli_module": "python -m gptok2_evaluation.cli",
    "evaluation_console_script": "gptok2-eval",
    "consumer_cli_module": "python -m rps_gtok_consumption.cli",
    "consumer_console_script": "gptok2-consumer"
  },
  "consumer_views": {
    "rps": ["rps_gtok_full", "rps_gtok_compact", "atomic_program", "rps_gtok_shuffled", "rps_gtok_random_ids"],
    "serialization_controls": ["edge_list_bpe", "adjacency_list_bpe", "dfs_order_bpe", "bfs_order_bpe", "graph_tokenizer_feuler_bpe"]
  },
  "verification": {
    "pytest": "python -m pytest tests -q",
    "release_check": "python scripts/verify_release.py",
    "smoke": "python scripts/reproduce_smoke.py"
  }
}
